# =====================================================================
# Medical RAG Chatbot - Environment Configuration
# =====================================================================

# LLM Configuration (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=1024

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# Reranker Configuration
RERANKER_MODEL=BAAI/bge-reranker-base
USE_RERANKER=true
TOP_K_RETRIEVAL=10
TOP_K_RERANK=4
SIMILARITY_THRESHOLD=0.35
RERANK_THRESHOLD=0.60

# Vector Store (ChromaDB)
CHROMA_PERSIST_DIRECTORY=chroma_db
CHROMA_COLLECTION_NAME=medical_knowledge_base

# SQLite Database
DATABASE_URL=sqlite:///./medical_chat.db

# Observability (LangSmith - Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=medical-rag-chatbot
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
